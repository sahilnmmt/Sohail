<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="?attr/materialCardViewFilledStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="88dp"
                android:layout_height="64dp"
                android:background="@android:color/black"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:id="@+id/details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/move_up"
                style="@style/ClipAction"
                android:contentDescription="@string/move_up"
                android:src="@drawable/ic_arrow_up" />

            <ImageButton
                android:id="@+id/move_down"
                style="@style/ClipAction"
                android:contentDescription="@string/move_down"
                android:src="@drawable/ic_arrow_down" />

            <ImageButton
                android:id="@+id/trim"
                style="@style/ClipAction"
                android:contentDescription="@string/trim"
                android:src="@drawable/ic_cut" />

            <ImageButton
                android:id="@+id/rotate"
                style="@style/ClipAction"
                android:contentDescription="@string/rotate"
                android:src="@drawable/ic_rotate" />

            <ImageButton
                android:id="@+id/remove"
                style="@style/ClipAction"
                android:contentDescription="@string/remove"
                android:src="@drawable/ic_delete" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
