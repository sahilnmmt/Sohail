# Copy to .env.local and fill in from Firebase console -> Project settings ->
# Your apps -> Web app. These values are public identifiers, not secrets
# (access is controlled by firestore.rules and Authentication settings).
# Leave them empty to run against the local emulators instead.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
